# Copy to backend/.env and adjust. Never commit the real .env file.

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./veriai.db

# LLM provider: "demo" (offline, deterministic, no key needed) or "openai" (any OpenAI-compatible API)
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# NLP / NLI
SPACY_MODEL=en_core_web_sm
NLI_ENABLED=true
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
NLI_PRELOAD=true

# Knowledge retrieval (comma-separated: wikipedia,wikidata)
KNOWLEDGE_PROVIDERS=wikipedia,wikidata
HTTP_TIMEOUT_SECONDS=8
HTTP_RETRIES=2

# Limits
MAX_INPUT_CHARS=8000
MAX_CLAIMS=15
